# Local review template only. Do not commit real values or NEXT_PUBLIC variants.
# Enable only after completing docs/contact-resend-migration.md and deployment approval.
CONTACT_FORM_ENABLED=false
# Build-time switch; leave formspree until saved intake + verified delivery are complete.
NEXT_PUBLIC_CONTACT_PROVIDER=formspree
# VERCEL=1 is supplied by Vercel itself. Do not fake it on another host.
RESEND_API_KEY=
# Single approved bare email address; sender domain must be verified in Resend.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Exact authorized HTTPS origin, no path or trailing slash; preview must be separate.
CONTACT_SITE_ORIGIN=
# Shared Upstash Redis store. Requires explicitly authorized setup/access.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Independent random secret of at least 32 characters; never NEXT_PUBLIC.
CONTACT_RATE_LIMIT_SECRET=

# Dedicated private Vercel Blob store with project-scoped OIDC. No static token fallback.
CONTACT_STORAGE_ENABLED=false
CONTACT_BLOB_STORE_ID=
CONTACT_BLOB_PROJECT_ID=
# BLOB_STORE_ID, VERCEL_PROJECT_ID, VERCEL_ENV and VERCEL_OIDC_TOKEN are supplied
# by the reviewed Vercel project/store connection. Do not copy tokens into files.
# No retention defaults: the firm must explicitly approve these and a review/purge process.
CONTACT_RETENTION_POLICY_ID=
CONTACT_RETENTION_DAYS=
CONTACT_RETENTION_WORKFLOW_CONFIRMED=false
